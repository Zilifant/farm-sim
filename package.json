{
  "name": "sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "demo": "node packages/refsim/dist/main.js",
    "bench": "node packages/refsim/dist/bench/main.js run",
    "bench:record": "node packages/refsim/dist/bench/main.js record",
    "bench:check": "node packages/refsim/dist/bench/main.js check",
    "check": "pnpm build && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
